# SNAPSHOT — the revision of the lab tree this deposit was taken from.
#
# This repository is a SNAPSHOT of a working tree, not a live mirror of it. The paper
# cites specific code, and a reader following one of those citations is looking at the
# code as it stood at the revision below — not at whatever the lab tree happens to say
# today. Re-syncing from a LATER revision produces a LATER snapshot, and this file then
# names that later revision.
#
# The lab tree has NO git history: the experiments were run in a plain working tree on
# the execution box and copied back, so there is no commit to name. `revision: none`
# records that fact rather than a sha a reader could mistake for a pin.

revision:                 none
revision_short:           none
snapshot_utc:             2026-10-30T19:39:39Z
source:                   ~/research/qlora-sleep, as executed 2026-10-29/30
